---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 1 && (
  <nav aria-label="목차" class="toc-nav">
    <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.12em] opacity-40">
      On this page
    </p>
    <ul class="border-l border-skin-line">
      {tocHeadings.map(({ depth, slug, text }) => (
        <li>
          <a
            href={`#${slug}`}
            data-toc-link
            data-toc-slug={slug}
            class:list={[
              "toc-link block border-l-2 border-transparent py-1 text-[13px] leading-snug",
              "text-foreground/50 transition-all duration-150",
              "hover:border-accent/60 hover:text-foreground/80",
              depth === 3 ? "pl-5 -ml-px" : "pl-3 -ml-px",
            ]}
          >
            {text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  function initToc() {
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
    if (!links.length) return;

    // slug → link 맵
    const linkMap = new Map<string, HTMLAnchorElement>();
    links.forEach(l => linkMap.set(l.dataset.tocSlug!, l));

    // article 안의 실제 heading 요소 수집
    const article = document.getElementById("article");
    if (!article) return;
    const headingEls = Array.from(
      article.querySelectorAll<HTMLElement>("h2[id], h3[id]")
    );

    function activate(slug: string) {
      links.forEach(l => {
        const active = l.dataset.tocSlug === slug;
        l.classList.toggle("border-accent", active);
        l.classList.toggle("text-accent", active);
        l.classList.toggle("font-medium", active);
        l.classList.toggle("border-transparent", !active);
        l.classList.toggle("text-foreground/50", !active);
      });
    }

    // 스크롤 기준: 현재 뷰포트 상단에서 가장 가까운 지나간 헤딩을 활성화
    function onScroll() {
      const scrollY = window.scrollY + 120; // 헤더 높이 오프셋

      let activeSlug = headingEls[0]?.id ?? "";
      for (const el of headingEls) {
        if (el.offsetTop <= scrollY) {
          activeSlug = el.id;
        } else {
          break;
        }
      }

      if (activeSlug) activate(activeSlug);
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    return () => window.removeEventListener("scroll", onScroll);
  }

  let cleanup = initToc();
  document.addEventListener("astro:after-swap", () => {
    cleanup?.();
    cleanup = initToc();
  });
</script>
