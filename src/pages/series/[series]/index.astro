---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getSeriesPosts } from "@/utils/getSeries";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";

export async function getStaticPaths() {
  const seriesEntries = await getCollection("series");
  return seriesEntries.map(entry => ({
    params: { series: slugifyStr(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, ogImage } = entry.data;
const { Content } = await render(entry);

const allPosts = await getCollection("blog");
const posts = getSeriesPosts(allPosts, slugifyStr(entry.id));

const firstDate = posts[0]?.data.pubDatetime;
const lastDate = posts[posts.length - 1]?.data.pubDatetime;

function formatDate(date: Date) {
  return date.toLocaleDateString("ko-KR", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).replace(/\. /g, ".").replace(/\.$/, "");
}

const dateRange =
  firstDate && lastDate
    ? firstDate.getTime() === lastDate.getTime()
      ? formatDate(firstDate)
      : `${formatDate(firstDate)} – ${formatDate(lastDate)}`
    : "";

const heroImage: ImageMetadata | null =
  ogImage && typeof ogImage !== "string" ? (ogImage as ImageMetadata) : null;
const heroSrc: string | null =
  typeof ogImage === "string" ? ogImage : null;
---

<Layout title={`Series: ${title} | ${SITE.title}`} hideSidebar={true}>
  <Header />

  {/* 시리즈 히어로 이미지 */}
  {(heroImage || heroSrc) && (
    <div class="flex w-full items-center overflow-hidden" style="max-height: min(400px, 45vh);">
      {heroImage ? (
        <Image
          src={heroImage}
          alt={title}
          width={1200}
          height={heroImage.height * (1200 / heroImage.width)}
          class="w-full h-auto"
          loading="eager"
        />
      ) : (
        <img src={heroSrc!} alt={title} class="w-full h-auto" loading="eager" />
      )}
    </div>
  )}

  <main class="app-layout pb-12 mt-8">
    {/* 시리즈 헤더 */}
    <h1 class="text-2xl font-bold text-accent sm:text-3xl">{title}</h1>
    {(dateRange || posts.length > 0) && (
      <div class="mt-2 flex items-center gap-2 text-sm opacity-60">
        {dateRange && <span>{dateRange}</span>}
        {dateRange && <span aria-hidden="true">·</span>}
        <span>총 {posts.length}편</span>
      </div>
    )}

    {/* 시리즈 소개 본문 */}
    <article class="app-prose mt-6 w-full max-w-app">
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    {/* 포스트 심플 리스트 */}
    <section>
      <h2 class="mb-4 text-base font-semibold opacity-70">포스트 목록</h2>
      <ol class="space-y-1">
        {posts.map((post, i) => (
          <li>
            <a
              href={getPath(post.id, post.filePath)}
              class="group flex items-baseline gap-3 rounded px-2 py-2 hover:bg-skin-fill transition-colors"
            >
              <span class="w-6 shrink-0 text-right text-sm font-mono opacity-40">
                {i + 1}
              </span>
              <span class="flex-1 text-sm group-hover:text-accent transition-colors">
                {post.data.title}
              </span>
              <span class="shrink-0 text-xs opacity-40">
                {formatDate(post.data.pubDatetime)}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>

  <Footer />
</Layout>
