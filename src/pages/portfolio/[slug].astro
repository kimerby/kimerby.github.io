---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import BackButton from "@/components/BackButton.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { SITE } from "@/config";
import { slugifyStr } from "@/utils/slugify";

export async function getStaticPaths() {
  const entries = await getCollection("portfolio", e => !e.data.draft);
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, year, type, description, tags, ogImage: initOgImage, heroImage: initHeroImage, links } =
  entry.data;

const { Content, headings } = await render(entry);

const rawHero = initHeroImage ?? initOgImage;
const heroImage: ImageMetadata | null =
  rawHero && typeof rawHero !== "string"
    ? (rawHero as ImageMetadata)
    : null;
const heroSrc: string | null =
  !heroImage && typeof rawHero === "string" ? rawHero : null;
---

<Layout
  title={`${title} | ${SITE.title}`}
  description={description}
  hideSidebar={true}
  scrollSmooth={true}
>
  <Header />

  {(heroImage || heroSrc) && (
    <div class="flex w-full items-center overflow-hidden" style="max-height: min(480px, 50vh);">
      {heroImage ? (
        <Image
          src={heroImage}
          alt={title}
          width={1200}
          height={heroImage.height * (1200 / heroImage.width)}
          class="w-full h-auto"
          loading="eager"
        />
      ) : (
        <img src={heroSrc!} alt={title} class="w-full h-auto" loading="eager" />
      )}
    </div>
  )}

  <BackButton />

  <main
    id="main-content"
    class:list={["app-layout pb-12", { "mt-8": !SITE.showBackButton }]}
  >
    <h1 class="inline-block text-3xl font-bold leading-tight text-accent sm:text-4xl">
      {title}
    </h1>

    <div class="my-2 flex items-center gap-2 text-sm opacity-70">
      <span>{year}</span>
      {type && <><span>·</span><span>{type}</span></>}
    </div>

    {links.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {links.map(link => (
          <a
            href={link.href}
            class="rounded border border-skin-line px-3 py-1.5 text-sm font-medium hover:bg-accent hover:text-white transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>
    )}

    <div class="relative mt-8" style="overflow: visible;">
      <article
        id="article"
        class="app-prose w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
      >
        <Content />
      </article>

      <div
        class="hidden xl:block absolute h-full"
        style="top: 0; left: calc(100% + 1.5rem); width: 13rem;"
      >
        <div class="sticky" style="top: 5rem;">
          <TableOfContents {headings} />
        </div>
      </div>
    </div>

    <hr class="my-8 border-dashed" />

    <ul class="mt-4 mb-8 flex flex-wrap gap-2 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>
  </main>

  <Footer />
</Layout>
