---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/layouts/Main.astro";
import { SITE } from "@/config";

const allEntries = await getCollection("portfolio", e => !e.data.draft);
const creativeWork = allEntries
  .filter(e => e.data.category === "creative")
  .sort((a, b) => a.data.order - b.data.order);
const itProjects = allEntries
  .filter(e => e.data.category === "it")
  .sort((a, b) => a.data.order - b.data.order);

function calcPeriod(start: string, end: string) {
  const [sy, sm] = start.split(".").map(Number);
  const [ey, em] = end.split(".").map(Number);
  const months = (ey - sy) * 12 + (em - sm) + 1;
  return `${start} ~ ${end} (${months}개월)`;
}

const cardBase = "group flex gap-4 rounded-lg transition-opacity hover:opacity-80";
const imgClass = "h-28 w-44 shrink-0 rounded-md object-cover sm:h-36 sm:w-56";
---

<Layout title={`Portfolio | ${SITE.title}`}>
  <Header />
  <Main pageTitle="Portfolio" pageDesc="Product Manager & Creator로서 진행한 프로젝트들입니다.">

    <!-- ── IT Projects ── -->
    <div class="mb-2 mt-2 flex items-center gap-3">
      <h2 class="text-xl font-bold tracking-tight sm:text-2xl">IT Projects</h2>
      <div class="flex-1 border-t border-border"></div>
    </div>
    <ul>
      {itProjects.map((entry, i) => {
        const { title, start, end, achievement, role, tech, ogImage } = entry.data;
        const img = ogImage && typeof ogImage !== "string"
          ? (ogImage as ImageMetadata)
          : null;
        return (
          <>
            {i > 0 && <hr class="my-6 border-dashed border-border" />}
            <li class="my-6">
              <a href={entry.data.cardHref ?? `/portfolio/${entry.id}`} class="group transition-opacity hover:opacity-80 block">
                <div>
                  <h2 class="text-xl font-semibold text-accent">{title}</h2>
                  {start && end && (
                    <p class="mt-1 text-sm opacity-50">{calcPeriod(start, end)}</p>
                  )}
                  <div class="mt-4 flex gap-6 items-start">
                    <div class="border-l-2 border-accent pl-4 space-y-4 flex-1">
                      {achievement && (
                        <div>
                          <span class="text-xs font-semibold uppercase tracking-widest opacity-40">성과</span>
                          <p class="text-base leading-relaxed">{achievement}</p>
                        </div>
                      )}
                      {role && (
                        <div>
                          <span class="text-xs font-semibold uppercase tracking-widest opacity-40">역할</span>
                          <p class="text-base leading-relaxed">{role}</p>
                        </div>
                      )}
                      {tech.length > 0 && (
                        <div>
                          <span class="text-xs font-semibold uppercase tracking-widest opacity-40">기술</span>
                          <div class="flex flex-wrap gap-1.5">
                            {tech.map(t => (
                              <span class="rounded-md bg-muted px-3 py-0.5 text-sm opacity-70">{t}</span>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                    {img && (
                      <Image
                        src={img}
                        alt={title}
                        width={224}
                        height={144}
                        class={imgClass}
                        loading="lazy"
                      />
                    )}
                  </div>
                </div>
              </a>
            </li>
          </>
        );
      })}
    </ul>

    <!-- ── Creative Work ── -->
    <div class="mb-2 mt-12 flex items-center gap-3">
      <h2 class="text-xl font-bold tracking-tight sm:text-2xl">Creative Work</h2>
      <div class="flex-1 border-t border-border"></div>
    </div>
    <ul>
      {creativeWork.map((entry) => {
        const { title, year, description, tags, ogImage } = entry.data;
        const img = ogImage && typeof ogImage !== "string"
          ? (ogImage as ImageMetadata)
          : null;
        return (
          <li class="my-6">
            <a
              href={entry.data.cardHref ?? `/portfolio/${entry.id}`}
              class:list={[cardBase, img ? "items-start" : "flex-col"]}
            >
              {img && (
                <Image
                  src={img}
                  alt={title}
                  width={224}
                  height={144}
                  class={imgClass}
                  loading="lazy"
                />
              )}
              <div>
                <h2 class="text-xl font-semibold text-accent">{title}</h2>
                <div class="mt-1 flex items-center gap-2 text-base opacity-70">
                  <span>{year}</span>
                </div>
                <p class="mt-2 text-base leading-relaxed">{description}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {tags.map(tag => (
                    <span class="rounded-md bg-muted px-3 py-1.5 text-sm opacity-70">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          </li>
        );
      })}
    </ul>

  </Main>
  <Footer />
</Layout>
